#!/bin/sh
# Pre-commit code smell check. Rules and opt-outs are in README.md next to this file.
root=$(git rev-parse --show-toplevel) || exit 0

if ! command -v python3 >/dev/null 2>&1; then
	echo "githooks: python3 not found, skipping check" >&2
	exit 0
fi

exit_code=0
python3 "$root/.githooks/check.py" --staged || exit_code=1
python3 "$root/.githooks/check_strings.py" --staged || exit_code=1
python3 "$root/.githooks/check_tokens.py" --staged || exit_code=1

exit $exit_code
