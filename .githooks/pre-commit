#!/bin/sh
# Pre-commit code smell check. Rules and opt-outs are in README.md next to this file.
root=$(git rev-parse --show-toplevel) || exit 0

if ! command -v python3 >/dev/null 2>&1; then
	echo "githooks: python3 not found, skipping check" >&2
	exit 0
fi

exec python3 "$root/.githooks/check.py" --staged
