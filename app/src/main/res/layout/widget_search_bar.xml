<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_gravity="center"
    android:background="@drawable/widget_search_bar_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <!-- Search Area: Icon + Search Query / Hint Text -->
    <LinearLayout
        android:id="@+id/widget_search_box"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_search_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_search_hint"
            android:src="@drawable/ic_widget_search" />

        <TextView
            android:id="@+id/widget_search_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_search_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Action / Run Button -->
    <ImageButton
        android:id="@+id/widget_action_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_action_button_background"
        android:contentDescription="@string/widget_action_run_desc"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_run" />

</LinearLayout>
